        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에서 실행 중인 데몬을 종료하고 앱이 직접 띄운 데몬으로 바꿉니다. 터미널 쪽 연결은 끊어집니다."
          }
        }
      }
    },
