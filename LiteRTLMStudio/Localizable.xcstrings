            "value": "일반"
          }
        }
      }
    },
    "settings.historyTurns": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation History"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 기록 전송"
          }
        }
      }
    },
    "settings.historyTurns.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much past conversation is included with each send. Sending the previous N turns lets the model keep context. Shorter is faster but truncates earlier context. Unlimited sends everything as before."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 전송에 포함할 과거 대화 범위. 이전 대화 N개를 함께 보내서 맥락을 기억하게 합니다. 짧을수록 빠르지만 앞부분 맥락이 잘립니다. 제한 없음은 기존 그대로 전부 전송합니다."
          }
        }
      }
    },
