    "settings.general.language.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies immediately. Some system text, such as permission dialogs, updates after the next launch."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 적용됩니다. 권한 대화상자처럼 시스템이 그리는 문구는 다음 실행 때 반영됩니다."
          }
        }
      }
    },
