    "settings.permission.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global permission for deleting, importing, and installing models. Off = blocked, Ask every time = confirm first, Allow all = run immediately. Chat sends are always allowed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 삭제·가져오기·설치에 적용되는 전역 권한. 사용 안 함=차단, 매번 묻기=확인 후 실행, 모두 허용=바로 실행. 채팅 전송은 항상 허용."
          }
        }
      }
    },
    "settings.permission.section": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한"
          }
        }
      }
    },
    "settings.prefillWarmup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefill on first touch"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫터치 프리필"
          }
        }
      }
    },
    "settings.prefillWarmup.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening a room preloads the base model to shorten the first response's warm-up. Leaving it on uses slightly more heat and battery."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방을 열람하면 기반 모델을 미리 준비해 첫 응답의 준비 구간을 줄입니다. 켜두면 발열·배터리를 조금 더 사용합니다."
          }
        }
      }
    },
    "settings.quitStopsDaemon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit the daemon when the app quits"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 종료 시 데몬도 함께 종료"
          }
        }
      }
    },
    "settings.quitStopsDaemon.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, the daemon keeps running after you quit and is ready on next launch. A terminal daemon always stays up."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 앱을 닫아도 데몬이 남아 다음 실행 때 바로 씁니다. 터미널 데몬은 항상 유지됩니다."
          }
        }
      }
    },
    "settings.route.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transport (server or in-app engine) is chosen each time in the chat input picker."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 경로(서버·앱 내 엔진)는 채팅 입력창의 피커에서 매번 선택합니다."
          }
        }
      }
    },
    "settings.route.note.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You pick the route in the input bar for every send. It is not saved in settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송할 때마다 입력창에서 경로를 고릅니다. 설정에 고정 저장되지 않습니다."
          }
        }
      }
    },
    "settings.select": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택"
          }
        }
      }
    },
    "settings.server.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The port is fixed at 127.0.0.1:9379 and models are read from ~/.litert-lm/models. Engine details are configured in the Runtime Settings tab of the main window inspector."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트는 127.0.0.1:9379 고정, 모델은 ~/.litert-lm/models 참조. 엔진 세부 설정은 메인 창 인스펙터의 실행 설정 탭에서 합니다."
          }
        }
      }
    },
